# Copy to server/.env.local (gitignored). Server-side only: never prefix with VITE_.
MG_BASE_URL=https://media-gateway.example.com:443
MG_USERNAME=
MG_PASSWORD=
MG_SDK_CERTIFICATE=
# Assumed token lifetime in seconds (the GWP docs do not define one).
TOKEN_TTL_SECONDS=60
PROXY_PORT=8787
# Camera catalog served at GET /api/genetec/cameras (gitignored).
CAMERAS_FILE=server/cameras.local.json
