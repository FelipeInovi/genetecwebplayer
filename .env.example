# Copy to .env.local (gitignored). VITE_ variables are inlined into the bundle:
# never put real secrets here and never build with a real bearer token.

# Leave empty to use the Vite dev proxy (/api -> http://127.0.0.1:8787, `pnpm proxy`).
VITE_API_URL=
# POC bearer fallback when localStorage.accessToken is not set (target app auth only).
VITE_DEV_BEARER_TOKEN=
# Media Gateway BASE URL (https://host:port, no /media suffix). Used by gwp mode.
VITE_MEDIA_GATEWAY_URL=
# mock: canvas test pattern | gwp: real Genetec Web Player
VITE_GENETEC_PLAYER_MODE=mock
# true: fixtures | false: GET /api/genetec/cameras and POST /api/genetec/token
VITE_USE_MOCK_API=true

# Live test: VITE_GENETEC_PLAYER_MODE=gwp, VITE_USE_MOCK_API=false,
# VITE_MEDIA_GATEWAY_URL=https://<media-gateway>:<port>

VITE_START_TIMEOUT_MS=30000

ALLOWED_ORIGINS=